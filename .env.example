# --- API KEYS ---
# Get this from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Get this from https://tavily.com/
TAVILY_API_KEY=your_tavily_key_here

# --- DATABASE CONFIG ---
# Default credentials for local Docker development
POSTGRES_USER=tradebrain_user
POSTGRES_PASSWORD=tradebrain_password
POSTGRES_DB=tradebrain_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# The URL SQLAlchemy uses to connect
DATABASE_URL=postgresql://tradebrain_user:tradebrain_password@localhost:5432/tradebrain_db

# --- SCANNER SCHEDULER CONFIG ---
# Enable/disable automatic scheduled scans
SCANNER_ENABLED=true

# Cron expression for scan schedule (default: 9 AM & 3 PM on weekdays)
# Format: minute hour day month day_of_week
SCANNER_CRON_EXPRESSION=0 9,15 * * 1-5

# Minimum confidence score to save signals (0-100)
SCANNER_MIN_CONFIDENCE=75