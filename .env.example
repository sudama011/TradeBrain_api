# Application
ENVIRONMENT=dev # dev, prod
DEBUG=True # True, False

# Security
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080 # 7 days
ALGORITHM=HS256

# API Keys
GEMINI_API_KEY=
TAVILY_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://tradebrain_user:tradebrain_password@localhost:5432/tradebrain_db
POSTGRES_USER=tradebrain_user
POSTGRES_PASSWORD=tradebrain_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradebrain_db
DATABASE_ECHO=False # True, False
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Scanner Scheduler
SCANNER_ENABLED=true
SCANNER_CRON_EXPRESSION=0 9,15 * * 1-5  # 9 AM & 3 PM on weekdays
SCANNER_MIN_CONFIDENCE=75

# Auditor Scheduler
AUDITOR_ENABLED=true
AUDITOR_CRON_EXPRESSION=*/30 9-16 * * 1-5  # Every 30 mins during market hours
